# Copy to .env before starting anything:  cp .env.example .env
#
# The server refuses to start without an OCI artifact to work against. A brain that
# cannot say where it publishes is a brain you cannot test, so this is a hard
# requirement rather than a default.

# --- The artifact (required) ---------------------------------------------------
# The repository this brain pushes to and pulls from. On Docker Hub the namespace
# must be your account or an organization you can write to; Docker Hub creates the
# repository on first push.
BOLTZMANN_REGISTRY=docker.io/<your-namespace>/boltzmann-sandbox

# The tag push and pull default to.
BOLTZMANN_TAG=v1

# --- Docker Hub credentials (required) ----------------------------------------
# A Personal Access Token, NOT your account password. Create one at
#   Docker Hub -> Account settings -> Personal access tokens -> Generate new token
# with the "Read & Write" scope. Read-only cannot push; Read/Write/Delete also works.
DOCKER_USERNAME=<your-docker-hub-user>
DOCKER_TOKEN=<dckr_pat_...>

# --- Local brain --------------------------------------------------------------
# The on-disk OCI layout. This directory *is* the brain: publishing copies out of it.
BOLTZMANN_BRAIN_PATH=./brain

# Who registers knowledge. Provenance records it on every write, so it is not
# cosmetic. Defaults to $USER.
BOLTZMANN_ACTOR=

# --- Escape hatches -----------------------------------------------------------
# Talk to a registry with no credentials. Correct for a public read-only pull, and
# for the local registry below. Push will still fail without credentials.
BOLTZMANN_ANONYMOUS=0

# Allow plain HTTP. Needed only for a local registry; never for Docker Hub.
BOLTZMANN_INSECURE=0

# --- Offline alternative ------------------------------------------------------
# To run against a local registry instead of Docker Hub, no account involved:
#
#   docker run -d -p 5000:5000 --name boltzmann-registry registry:2
#
# then set:
#   BOLTZMANN_REGISTRY=localhost:5000/demo/brain
#   BOLTZMANN_INSECURE=1
#   BOLTZMANN_ANONYMOUS=1
